### fetch stock data

def fetch_stock(state):
    ticker = state["ticker"]
    stock = yf.Ticker(ticker)
    hist = stock.history(period="5d")
    latest = hist["Close"].iloc[-1]
    old = hist["Close"].iloc[0]

    change = ((latest - old) / old ) * 100

    return {
        "stock_data":
        f"""
    Ticker: {ticker}
    Current Price: ${latest:.2f}
    5 day Change: {change:.2f}%
    """
    }
