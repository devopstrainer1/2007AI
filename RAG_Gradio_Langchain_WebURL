### STEP 4: downloading file from internet

pdf_url = "https://www.iima.ac.in/sites/default/files/2023-01/HR%20Policy%20Manual%202023%20%288%29.pdf"

response = requests.get(pdf_url)
with open("hr_policy.pdf", "wb") as f:
  f.write(response.content)

loader = PyPDFLoader("hr_policy.pdf")
pages = loader.load()

text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=2500,
    chunk_overlap=300
)

docs = text_splitter.split_documents(pages)


### step 5 - create embedding & vector store

embeddings = HuggingFaceEmbeddings(
    model_name="sentence-transformers/all-MiniLM-L6-v2"
)

vectorstore = Chroma.from_documents(
    docs,
    embeddings,
    collection_name="hr_policy"
)

### dense retrieval technique...
retriever = vectorstore.as_retriever(search_kwargs={"k": 8})


### prompt template
### task - make this better------
prompt_template = """
You are an HR assistant.

Use the following context to answer the question.
If the answer is not in the context, say:
"I could not find this in the HR policy."

Be clear, concise and professional

Context:
{context}

Question: 
{question}
"""

PROMPT = PromptTemplate(
    template=prompt_template,
    input_variables=["context", "question"]
)

### step 6 - create QA chain

llm = ChatGoogleGenerativeAI(model="gemini-2.5-flash", temperature=0)

qa_chain = RetrievalQA.from_chain_type(
    llm=llm,
    chain_type_kwargs={"prompt": PROMPT},
    chain_type="stuff", ### map_reduce, refine
    retriever=retriever
)

#### step 7 - create gradio chatbot


def chatbot(query):
  try:
    return qa_chain.run(query)
  except Exception as e:
    return "Error: {e}"

demo = gr.Interface(
    fn=chatbot,
    inputs=gr.Textbox(label="Ask HR assistant some question", lines=3, placeholder="Enter your query here..."),
    outputs=gr.Textbox(label="HR assistant's response", lines=12),
    title="AI powered Hr assistant"
)

demo.launch(
    share=True
)
